---
const today = new Date();
---

<footer>
	<div class="inner">
		<span>&copy; {today.getFullYear()} Flora Ma</span>
		<div class="links">
			<a href="/rss.xml">RSS</a>
			<a href="https://github.com/violet-quartz" target="_blank" rel="me noopener">GitHub</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
	}
	.inner {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.6rem var(--gutter) 2.4rem;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-sans);
		font-size: 0.74rem;
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: 1.1rem;
	}
	.inner a {
		color: var(--muted);
		text-decoration: none;
	}
	.inner a:hover {
		color: var(--ink);
	}
</style>
