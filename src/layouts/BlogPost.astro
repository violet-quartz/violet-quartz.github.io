---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, tags, headings = [] } = Astro.props;
// h2/h3 only: deeper levels make the outline noisier than the article.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post">
			<article>
				<header class="post-head">
					<h1>{title}</h1>
					<p class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								· 更新于 <FormattedDate date={updatedDate} />
							</span>
						)}
						{tags.map((tag) => <span class="tag">{tag}</span>)}
					</p>
				</header>

				{
					heroImage && (
						<figure class="hero">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</figure>
					)
				}

				{
					toc.length > 0 && (
						<details class="toc-inline">
							<summary>目录</summary>
							<TableOfContents headings={toc} />
						</details>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<a class="back" href="/blog">← 全部文章</a>
			</article>

			{
				toc.length > 0 && (
					<aside class="toc-side">
						<div class="toc-sticky">
							<p class="toc-label">目录</p>
							<TableOfContents headings={toc} />
						</div>
					</aside>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-head {
		margin-bottom: 2rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--rule);
	}
	.post-head h1 {
		margin: 0 0 0.6rem;
	}
	.meta {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}
	.tag {
		background: var(--bg-subtle);
		border: 1px solid var(--rule);
		border-radius: 999px;
		padding: 0.05em 0.6em;
		font-size: 0.92em;
	}

	.hero {
		margin: 0 0 2rem;
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 6px;
	}

	/* First heading of a post shouldn't push extra space under the title rule. */
	.prose :global(> :first-child) {
		margin-top: 0;
	}

	/* Collapsed outline at the top of the article; replaced by the sidebar on
	   wide screens. */
	.toc-inline {
		margin: 0 0 2rem;
		padding: 0.6rem 1rem;
		background: var(--bg-subtle);
		border: 1px solid var(--rule);
		border-radius: 6px;
		font-size: 0.92rem;
	}
	.toc-inline summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--ink);
	}
	.toc-inline[open] summary {
		margin-bottom: 0.5rem;
	}

	.toc-side {
		display: none;
	}

	.back {
		display: inline-block;
		margin-top: 3.5rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--rule);
		width: 100%;
		box-sizing: border-box;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.back:hover {
		color: var(--accent);
	}

	/* Wide screens: article stays centred at --measure, the outline sits in
	   the right margin and follows the reader. */
	@media (min-width: 1360px) {
		.post {
			max-width: none;
			display: grid;
			grid-template-columns: 1fr minmax(0, var(--measure)) 1fr;
			padding-left: 0;
			padding-right: 0;
		}
		.post > article {
			grid-column: 2;
			min-width: 0;
			padding: 0 var(--gutter);
		}
		.toc-inline {
			display: none;
		}
		.toc-side {
			display: block;
			grid-column: 3;
			padding-left: var(--toc-gap);
		}
		.toc-sticky {
			position: sticky;
			top: 2rem;
			width: var(--toc-width);
			max-height: calc(100vh - 4rem);
			overflow-y: auto;
			font-size: 0.82rem;
			line-height: 1.5;
		}
		.toc-label {
			margin: 0 0 0.6rem;
			font-size: 0.72rem;
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--muted);
		}
	}
</style>

<script>
	// Scroll-spy for the sidebar outline: highlight the entry for the last
	// heading that has scrolled past the top of the viewport.
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-side a[href^="#"]'));
	if (links.length > 0) {
		const targets = links
			.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
			.filter((el): el is HTMLElement => el !== null);

		let ticking = false;
		const update = () => {
			ticking = false;
			const line = 96;
			let current: HTMLElement | null = null;
			for (const el of targets) {
				if (el.getBoundingClientRect().top <= line) current = el;
				else break;
			}
			for (const a of links) {
				a.classList.toggle('active', current !== null && decodeURIComponent(a.hash.slice(1)) === current.id);
			}
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		window.addEventListener('scroll', onScroll, { passive: true });
		update();
	}
</script>
