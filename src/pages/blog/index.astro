---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Posts are already newest-first, so walking them in order yields years in order too.
const byYear = posts.reduce<Map<number, typeof posts>>((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	if (!acc.has(year)) acc.set(year, []);
	acc.get(year)!.push(post);
	return acc;
}, new Map());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			<p class="intro">{SITE_DESCRIPTION}</p>

			{
				[...byYear].map(([year, yearPosts]) => (
					<section class="year">
						<h2 class="eyebrow">{year}</h2>
						<ul>
							{yearPosts.map((post) => (
								<li>
									<a class="title" href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.tags.map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</p>
									<p class="summary">{post.data.description}</p>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		color: var(--muted);
		margin: 0 0 3.5rem;
		max-width: 32em;
	}

	.year {
		margin-bottom: 3.2rem;
	}
	.year:last-child {
		margin-bottom: 0;
	}
	.year ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.year li {
		margin: 0 0 2.2rem;
	}
	.year li:last-child {
		margin-bottom: 0;
	}

	.title {
		display: block;
		font-size: 1.14rem;
		font-weight: 600;
		color: var(--ink);
		line-height: 1.35;
		text-decoration: none;
	}
	.title:hover {
		color: var(--accent);
	}
	.meta {
		margin: 0.3rem 0 0.45rem;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem;
	}
	.tag::before {
		content: '·';
		margin-right: 0.55rem;
	}
	.summary {
		margin: 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.65;
	}
</style>
