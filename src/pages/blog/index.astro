---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { categories, categoryOf, uncategorized } from '../../data/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group by category in config order, "其他" last; posts are already
// newest-first, so each group stays newest-first too. Empty groups are dropped.
const byCategory = [...categories.map((c) => c.name), uncategorized]
	.map((name) => [name, posts.filter((post) => categoryOf(post.data.tags) === name)] as const)
	.filter(([, group]) => group.length > 0);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Articles</h1>
			<p class="intro">{SITE_DESCRIPTION}</p>

			{
				byCategory.map(([name, groupPosts]) => (
					<details class="group">
						<summary>
							<h2 class="eyebrow">{name}</h2>
						</summary>
						<ul>
							{groupPosts.map((post) => (
								<li>
									<a class="title" href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.tags.map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</p>
									<p class="summary">{post.data.description}</p>
								</li>
							))}
						</ul>
					</details>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		color: var(--muted);
		margin: 0 0 3rem;
		max-width: 36em;
	}

	/* Each category folds; the heading doubles as the toggle. */
	.group {
		margin-bottom: 1.2rem;
	}
	.group[open] {
		margin-bottom: 2.6rem;
	}
	.group summary {
		list-style: none;
		cursor: pointer;
	}
	.group summary::-webkit-details-marker {
		display: none;
	}
	.group .eyebrow {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0;
	}
	.group[open] .eyebrow {
		margin-bottom: 1.1rem;
	}
	/* Chevron: points right when closed, down when open. */
	.group .eyebrow::before {
		content: '';
		width: 0.45em;
		height: 0.45em;
		border-right: 2px solid var(--muted);
		border-bottom: 2px solid var(--muted);
		transform: rotate(-45deg);
		transition: transform 0.15s ease;
		flex: none;
	}
	.group[open] .eyebrow::before {
		transform: rotate(45deg);
	}
	.group summary:hover .eyebrow {
		color: var(--accent);
	}
	.group ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.group li {
		margin: 0 0 1.6rem;
	}
	.group li:last-child {
		margin-bottom: 0;
	}

	.title {
		display: block;
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--ink);
		line-height: 1.4;
	}
	.title:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.meta {
		margin: 0.3rem 0 0.45rem;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem;
	}
	.tag::before {
		content: '·';
		margin-right: 0.55rem;
	}
	.summary {
		margin: 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.65;
	}
</style>
