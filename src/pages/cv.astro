---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { education, experience, profile, projects, skills } from '../data/cv';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`CV — ${profile.name}`} description={profile.tagline} />
	</head>
	<body>
		<div class="screen-only"><Header /></div>
		<main class="cv">
			<header class="masthead">
				<h1>{profile.name}</h1>
				<p class="tagline">{profile.tagline}</p>
				<ul class="links">
					{
						profile.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</header>

			<section>
				<h2>Projects</h2>
				{
					projects.map((project) => (
						<article class="entry">
							<div class="entry-head">
								<h3>
									<a href={project.href}>{project.name}</a>
								</h3>
								{project.writeup && (
									<a class="meta" href={project.writeup}>
										write-up →
									</a>
								)}
							</div>
							<p class="blurb">{project.blurb}</p>
							<ul>
								{project.highlights.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</article>
					))
				}
			</section>

			<section>
				<h2>Experience</h2>
				{
					experience.map((job) => (
						<article class="entry">
							<div class="entry-head">
								<h3>
									{job.role} · <span class="org">{job.org}</span>
								</h3>
								<span class="meta">
									{job.start} – {job.end}
								</span>
							</div>
							<p class="blurb">{job.location}</p>
							<ul>
								{job.highlights.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</article>
					))
				}
			</section>

			<section>
				<h2>Skills</h2>
				<dl class="skills">
					{
						skills.map((skill) => (
							<div class="skill-row">
								<dt>{skill.group}</dt>
								<dd>{skill.items.join(' · ')}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section>
				<h2>Education</h2>
				{
					education.map((school) => (
						<article class="entry">
							<div class="entry-head">
								<h3>
									{school.degree} · <span class="org">{school.org}</span>
								</h3>
								<span class="meta">
									{school.start} – {school.end}
								</span>
							</div>
							{school.note && <p class="blurb">{school.note}</p>}
						</article>
					))
				}
			</section>

			<p class="print-hint screen-only">
				Tip: <kbd>⌘P</kbd> → Save as PDF gives you a clean one-page version.
			</p>
		</main>
		<div class="screen-only"><Footer /></div>
	</body>
</html>

<style>
	/* Denser than the blog body copy — a CV is scanned, not read. */
	.cv {
		font-size: 17px;
		line-height: 1.55;
	}

	.masthead {
		margin-bottom: 2.5rem;
	}
	.masthead h1 {
		font-size: 2.2em;
		margin-bottom: 0.15rem;
	}
	.tagline {
		color: rgb(var(--gray));
		margin: 0 0 0.6rem 0;
	}
	.links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		font-size: 0.9em;
	}

	section {
		margin-bottom: 2.2rem;
	}
	section h2 {
		font-size: 0.82em;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgb(var(--gray));
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 0.35rem;
		margin-bottom: 1.1rem;
	}

	.entry {
		margin-bottom: 1.4rem;
	}
	.entry:last-child {
		margin-bottom: 0;
	}
	/* Title left, dates right — the scan pattern recruiters expect. */
	.entry-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.entry-head h3 {
		font-size: 1.02em;
		margin: 0;
	}
	.org {
		font-weight: 400;
	}
	.meta {
		font-size: 0.85em;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.blurb {
		margin: 0.15rem 0 0.4rem 0;
		color: rgb(var(--gray));
		font-size: 0.92em;
	}
	.entry ul {
		margin: 0;
		padding-left: 1.1rem;
	}
	.entry li {
		margin-bottom: 0.25rem;
	}

	.skills {
		margin: 0;
	}
	.skill-row {
		display: flex;
		gap: 1rem;
		margin-bottom: 0.45rem;
	}
	.skill-row dt {
		flex: 0 0 6.5rem;
		font-weight: 700;
		font-size: 0.92em;
	}
	.skill-row dd {
		margin: 0;
		font-size: 0.92em;
	}

	.print-hint {
		margin-top: 3rem;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}

	@media (max-width: 620px) {
		.entry-head {
			flex-direction: column;
			gap: 0.1rem;
		}
		.skill-row {
			flex-direction: column;
			gap: 0.1rem;
		}
		.skill-row dt {
			flex-basis: auto;
		}
	}

	/* ⌘P output: drop the site chrome, tighten to fit a page, show link targets
	   since a printed <a> is dead otherwise. */
	@media print {
		.screen-only {
			display: none !important;
		}
		.cv {
			font-size: 10.5pt;
			line-height: 1.4;
			width: 100%;
			max-width: none;
			padding: 0;
		}
		.masthead {
			margin-bottom: 1.2rem;
		}
		.masthead h1 {
			font-size: 1.9em;
		}
		section {
			margin-bottom: 1.1rem;
		}
		section h2 {
			margin-bottom: 0.6rem;
		}
		.entry {
			margin-bottom: 0.8rem;
			/* Never split an entry across a page boundary. */
			break-inside: avoid;
		}
		a {
			color: inherit;
			text-decoration: none;
		}
		.links a::after {
			content: '';
		}
		.entry-head a[href^='http']::after {
			content: ' (' attr(href) ')';
			font-size: 0.82em;
			font-weight: 400;
			color: #555;
		}
	}
</style>

<style is:global>
	@media print {
		body {
			background: none;
		}
		main {
			padding: 0;
		}
		@page {
			margin: 14mm;
		}
	}
</style>
